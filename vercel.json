{
  "version": 2,
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/rl-snapshot",
      "schedule": "20 4 * * 1"
    }
  ],
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["data.json"],
        "maxDuration": 30
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/uat/portal/(.*)", "dest": "/api/index.js" },
    { "src": "/portal/(.*)", "dest": "/public/portal.html", "headers": { "cache-control": "no-cache, no-store, must-revalidate" } },
    { "src": "/uploads/(.*)", "dest": "/public/uploads/$1" },
    {
      "src": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf))",
      "dest": "/public/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/(.*\\.(css|js))",
      "dest": "/public/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html",
      "headers": { "cache-control": "no-cache, no-store, must-revalidate" }
    }
  ]
}
