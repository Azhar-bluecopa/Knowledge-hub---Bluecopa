# Copy this file to .env and fill in your values

# Server port (platforms set this automatically — don't change)
PORT=3000

# Admin password for the knowledge hub
ADMIN_PASSWORD=your_password_here

# Rocketlane API key — get from Rocketlane → Settings → API Keys (Read access)
# Add this to Vercel → Project → Environment Variables for production
ROCKETLANE_API_KEY=
